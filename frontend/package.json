{
  "name": "tuteasy-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:watch": "vitest --watch",
    "test:components": "vitest run --testPathPattern=components",
    "test:services": "vitest run --testPathPattern=services",
    "test:hooks": "vitest run --testPathPattern=hooks",
    "test:stores": "vitest run --testPathPattern=stores",
    "test:utils": "vitest run --testPathPattern=utils",
    "coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:debug": "playwright test --debug",
    "e2e:report": "playwright show-report"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.10.0",
    "@tanstack/react-query": "^5.80.5",
    "@types/bcryptjs": "^2.4.6",
    "axios": "^1.6.5",
    "bcryptjs": "^3.0.2",
    "clsx": "^2.1.0",
    "date-fns": "^3.0.6",
    "framer-motion": "^10.17.9",
    "lucide-react": "^0.513.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-dropzone": "^14.3.8",
    "react-hook-form": "^7.57.0",
    "react-image-crop": "^11.0.10",
    "react-router-dom": "^6.21.1",
    "tailwind-merge": "^2.2.0",
    "zod": "^3.25.51",
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/react-image-crop": "^8.1.6",
    "@typescript-eslint/eslint-plugin": "^8.13.0",
    "@typescript-eslint/parser": "^8.13.0",
    "@vitejs/plugin-react": "^4.3.3",
    "@vitest/coverage-v8": "^3.2.4",
    "artillery": "^2.0.23",
    "autoprefixer": "^10.4.16",
    "eslint": "^9.13.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "jsdom": "^26.1.0",
    "msw": "^2.10.4",
    "postcss": "^8.4.33",
    "tailwindcss": "^3.4.0",
    "typescript": "~5.6.2",
    "vite": "^5.4.10",
    "vitest": "^3.2.4"
  }
}
